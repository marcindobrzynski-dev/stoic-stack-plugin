# Dependencies
node_modules/

# Installed agent skill libraries (installed locally, not versioned with the plugin)
.claude/**
skills-lock.json

# Local agent tool config — machine-specific absolute paths, not versioned
.grok/

# Agent operating library — allow-list. Everything under .agents/ is ignored
# except the files named below; anything new must be un-ignored explicitly.
.agents/**
!.agents/README.md
!.agents/rules/
!.agents/rules/**
!.agents/standards/
!.agents/standards/**
!.agents/memory/
!.agents/memory/conventions.md
!.agents/memory/anti-patterns.md

# Maintainer-only pointer to planning outside the repo (imports .agents/local.md)
CLAUDE.local.md

# Project documents — allow-list. Only the approved .project documents are
# versioned; feature workspaces, research, and private notes live outside the repo.
thoughts/**
!thoughts/shared/
!thoughts/shared/.project/
!thoughts/shared/.project/**
