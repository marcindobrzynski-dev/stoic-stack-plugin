{
  "name": "stoic-stack-plugin",
  "version": "0.1.0",
  "description": "A background guardian for Claude Code that prompts you to reflect every so often, so you keep ownership of the decisions your AI is helping you make.",
  "type": "module",
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "fallow": "fallow"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.7.0",
    "fallow": "^3.3.0",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "prettier": "3.9.5"
  }
}
